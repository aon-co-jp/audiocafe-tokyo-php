[Unit]
Description=aruaru-llm (contract-free AI inference, open-cuda SET)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/aruaru-llm
Environment=ARUARU_LLM_BIND=127.0.0.1:4600
Environment=RUST_LOG=info
Environment=ARUARU_LLM_WHISPER_MODEL=/root/repository/aruaru-llm/models/whisper/ggml-small.bin
Environment=ARUARU_LLM_GPT2_DIR=models/gpt2
EnvironmentFile=-/root/aruaru-llm/.env.google-search
EnvironmentFile=-/root/aruaru-llm/.env.providers
ExecStart=/root/aruaru-llm/target/release/aruaru-llm
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
